# Answer directories and working trees the seeds build in $HOME. They should
# never appear here, but they do when someone runs a seed from inside a clone.
answers*/
exam[0-9]*/
dist/
*.tgz
cka-helm/
cka-helm2/

# demo/out/ is scratch: whatever you happen to be recording. The one asset the
# README actually shows is committed at demo/*.gif, deliberately and by name,
# so it is obvious when it goes stale — the GIF that shipped through 1.x still
# showed 'exam3' and 'q3 2' long after those stopped being the documented
# commands, because nobody could see which file the README was pointing at.
demo/out/

# Local editor/agent settings, not project config.
.claude/

# FUSE leftovers from editing files that were open elsewhere.
.fuse_hidden*
